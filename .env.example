EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-key
EXPO_PUBLIC_ROBOFLOW_API_KEY=your-roboflow-key
EXPO_PUBLIC_EXCHANGE_RATE_API_KEY=your-exchangerate-api-key

# Optional: map tiles for the Users Online map (defaults to OpenStreetMap)
# EXPO_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# EXPO_PUBLIC_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors

# Optional: address lookup for P2P cash delivery (defaults to OpenStreetMap Nominatim, Philippines only)
# EXPO_PUBLIC_GEOCODER_URL=https://nominatim.openstreetmap.org/search
# EXPO_PUBLIC_P2P_COUNTRY=ph
