{
  "expo": {
    "name": "YTCash",
    "slug": "YTCash",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ytcash",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ytcash.app",
      "infoPlist": {
        "NSCameraUsageDescription": "YTCash needs camera access to scan banknotes and QR codes.",
        "NSPhotoLibraryUsageDescription": "YTCash needs photo library access to select images for scanning."
      }
    },
    "android": {
      "package": "com.ytcash.app",
      "adaptiveIcon": {
        "backgroundColor": "#F7931A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "YTCash needs camera access to scan banknotes and QR codes."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "YTCash needs photo library access to select images for scanning."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F7931A",
          "dark": {
            "backgroundColor": "#E8850D"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
